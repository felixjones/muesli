#pragma once

#include <cstdint>
#include <string_view>
#include <tuple>
#include <type_traits>

namespace muesli::schema {

/**
 * @brief Enumeration of primitive type kinds recognised by the schema IR
 */
enum class primitive_kind : std::uint8_t {
    boolean,
    signed_integer,
    unsigned_integer,
    floating_point,
    string,
    monostate
};

// -- Schema node types (compile-time, zero-overhead) -----------------------

/**
 * @brief Schema node for a primitive (leaf) type
 * @tparam K The primitive kind
 */
template<primitive_kind K>
struct primitive_schema {
    static constexpr primitive_kind kind = K;
};

/**
 * @brief A named field inside an object schema
 * @tparam Schema The schema type for this field's value
 *
 * @code
 * schema_field<primitive_schema<primitive_kind::signed_integer>>{"age", true, {}}
 * @endcode
 */
template<typename Schema>
struct schema_field {
    std::string_view name{};
    bool required{true};
    Schema schema{};
};

/**
 * @brief Schema node for a named-member struct (all members carry names)
 * @tparam Fields Variadic schema_field types, one per member
 */
template<typename... Fields>
struct object_schema {
    std::tuple<Fields...> fields{};
};

/**
 * @brief Schema node for a homogeneous collection (vector, array, etc.)
 * @tparam Element The schema type for the collection's element
 */
template<typename Element>
struct array_schema {
    Element element{};
};

/**
 * @brief Schema node for an optional value
 * @tparam Inner The schema type for the wrapped value
 */
template<typename Inner>
struct optional_schema {
    Inner inner{};
};

/**
 * @brief Schema node for a positional (unnamed) tuple
 * @tparam Elements Variadic schema types, one per position
 */
template<typename... Elements>
struct tuple_schema {
    std::tuple<Elements...> elements{};
};

/**
 * @brief Schema node for a tagged union (variant)
 * @tparam Alternatives Variadic schema types, one per alternative
 */
template<typename... Alternatives>
struct variant_schema {
    std::tuple<Alternatives...> alternatives{};
};

// -- Deduction guides -------------------------------------------------------

template<typename... Fields>
object_schema(std::tuple<Fields...>) -> object_schema<Fields...>;

template<typename Element>
array_schema(Element) -> array_schema<Element>;

template<typename Inner>
optional_schema(Inner) -> optional_schema<Inner>;

template<typename... Elements>
tuple_schema(std::tuple<Elements...>) -> tuple_schema<Elements...>;

template<typename... Alternatives>
variant_schema(std::tuple<Alternatives...>) -> variant_schema<Alternatives...>;

// -- Type detection traits --------------------------------------------------

/** @brief True if T is a primitive_schema */
template<typename T> struct is_primitive : std::false_type {};
template<primitive_kind K> struct is_primitive<primitive_schema<K>> : std::true_type {};
template<typename T> inline constexpr bool is_primitive_v = is_primitive<std::decay_t<T>>::value;

/** @brief True if T is an object_schema */
template<typename T> struct is_object : std::false_type {};
template<typename... Fs> struct is_object<object_schema<Fs...>> : std::true_type {};
template<typename T> inline constexpr bool is_object_v = is_object<std::decay_t<T>>::value;

/** @brief True if T is an array_schema */
template<typename T> struct is_array : std::false_type {};
template<typename E> struct is_array<array_schema<E>> : std::true_type {};
template<typename T> inline constexpr bool is_array_v = is_array<std::decay_t<T>>::value;

/** @brief True if T is an optional_schema */
template<typename T> struct is_optional : std::false_type {};
template<typename I> struct is_optional<optional_schema<I>> : std::true_type {};
template<typename T> inline constexpr bool is_optional_v = is_optional<std::decay_t<T>>::value;

/** @brief True if T is a tuple_schema */
template<typename T> struct is_tuple : std::false_type {};
template<typename... Es> struct is_tuple<tuple_schema<Es...>> : std::true_type {};
template<typename T> inline constexpr bool is_tuple_v = is_tuple<std::decay_t<T>>::value;

/** @brief True if T is a variant_schema */
template<typename T> struct is_variant : std::false_type {};
template<typename... As> struct is_variant<variant_schema<As...>> : std::true_type {};
template<typename T> inline constexpr bool is_variant_v = is_variant<std::decay_t<T>>::value;

// -- Count helpers ----------------------------------------------------------

/** @brief Number of fields in an object_schema */
template<typename T> struct field_count;
template<typename... Fs> struct field_count<object_schema<Fs...>> {
    static constexpr std::size_t value = sizeof...(Fs);
};
template<typename T> inline constexpr std::size_t field_count_v = field_count<std::decay_t<T>>::value;

/** @brief Number of elements in a tuple_schema */
template<typename T> struct element_count;
template<typename... Es> struct element_count<tuple_schema<Es...>> {
    static constexpr std::size_t value = sizeof...(Es);
};
template<typename T> inline constexpr std::size_t element_count_v = element_count<std::decay_t<T>>::value;

/** @brief Number of alternatives in a variant_schema */
template<typename T> struct alternative_count;
template<typename... As> struct alternative_count<variant_schema<As...>> {
    static constexpr std::size_t value = sizeof...(As);
};
template<typename T> inline constexpr std::size_t alternative_count_v = alternative_count<std::decay_t<T>>::value;

} // namespace muesli::schema

