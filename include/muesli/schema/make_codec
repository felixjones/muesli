#pragma once

#include <muesli/schema/named_codec>
#include <muesli/schema/types>
#include <muesli/codecs>

#include <cstdint>
#include <string>
#include <tuple>
#include <type_traits>

namespace muesli {

namespace schema_detail {

    /**
     * @brief Builds a concrete muesli codec from a compile-time schema node
     *
     * Exact primitive kinds (for example float_32/float_64/float_128, int32,
     * uint16, char8) map back to their corresponding provided codecs.
     * Generic kinds (signed_integer/unsigned_integer/floating_point) remain
     * available as compatibility categories and map to canonical codecs.
     */
    struct codec_builder {

        template<typename S>
        static constexpr auto build(const S& schema) {
            if constexpr (schema::is_primitive_v<S>) {
                return build_primitive(schema);
            }
            else if constexpr (schema::is_optional_v<S>) {
                return optional_codec(build(schema.inner));
            }
            else if constexpr (schema::is_array_v<S>) {
                return vector_of(build(schema.element));
            }
            else if constexpr (schema::is_object_v<S>) {
                return build_object(schema, std::make_index_sequence<
                    std::tuple_size_v<std::decay_t<decltype(schema.fields)>>>{});
            }
            else if constexpr (schema::is_tuple_v<S>) {
                return build_tuple(schema, std::make_index_sequence<
                    std::tuple_size_v<std::decay_t<decltype(schema.elements)>>>{});
            }
            else if constexpr (schema::is_variant_v<S>) {
                return build_variant(schema, std::make_index_sequence<
                    std::tuple_size_v<std::decay_t<decltype(schema.alternatives)>>>{});
            }
        }

    private:
        template<schema::fundamental_kind K>
        static constexpr auto build_primitive(const schema::primitive_schema<K>&) {
            if constexpr (K == schema::fundamental_kind::boolean) {
                return bool_codec;
            }
            else if constexpr (K == schema::fundamental_kind::signed_integer) {
                return int64_codec;
            }
            else if constexpr (K == schema::fundamental_kind::unsigned_integer) {
                return uint64_codec;
            }
            else if constexpr (K == schema::fundamental_kind::floating_point) {
                return double_codec;
            }
            else if constexpr (K == schema::fundamental_kind::float_32) {
                return float_codec;
            }
            else if constexpr (K == schema::fundamental_kind::float_64) {
                return double_codec;
            }
            else if constexpr (K == schema::fundamental_kind::float_128) {
                return long_double_codec;
            }
            else if constexpr (K == schema::fundamental_kind::short_integer) {
                return short_codec;
            }
            else if constexpr (K == schema::fundamental_kind::int_integer) {
                return int_codec;
            }
            else if constexpr (K == schema::fundamental_kind::long_integer) {
                return long_codec;
            }
            else if constexpr (K == schema::fundamental_kind::long_long_integer) {
                return long_long_codec;
            }
            else if constexpr (K == schema::fundamental_kind::unsigned_short_integer) {
                return unsigned_short_codec;
            }
            else if constexpr (K == schema::fundamental_kind::unsigned_int_integer) {
                return unsigned_int_codec;
            }
            else if constexpr (K == schema::fundamental_kind::unsigned_long_integer) {
                return unsigned_long_codec;
            }
            else if constexpr (K == schema::fundamental_kind::unsigned_long_long_integer) {
                return unsigned_long_long_codec;
            }
            else if constexpr (K == schema::fundamental_kind::int8) {
                return int8_codec;
            }
            else if constexpr (K == schema::fundamental_kind::int16) {
                return int16_codec;
            }
            else if constexpr (K == schema::fundamental_kind::int32) {
                return int32_codec;
            }
            else if constexpr (K == schema::fundamental_kind::int64) {
                return int64_codec;
            }
            else if constexpr (K == schema::fundamental_kind::uint8) {
                return uint8_codec;
            }
            else if constexpr (K == schema::fundamental_kind::uint16) {
                return uint16_codec;
            }
            else if constexpr (K == schema::fundamental_kind::uint32) {
                return uint32_codec;
            }
            else if constexpr (K == schema::fundamental_kind::uint64) {
                return uint64_codec;
            }
            else if constexpr (K == schema::fundamental_kind::intmax) {
                return intmax_codec;
            }
            else if constexpr (K == schema::fundamental_kind::uintmax) {
                return uintmax_codec;
            }
            else if constexpr (K == schema::fundamental_kind::intptr) {
                return intptr_codec;
            }
            else if constexpr (K == schema::fundamental_kind::uintptr) {
                return uintptr_codec;
            }
            else if constexpr (K == schema::fundamental_kind::size) {
                return size_codec;
            }
            else if constexpr (K == schema::fundamental_kind::ptrdiff) {
                return ptrdiff_codec;
            }
            else if constexpr (K == schema::fundamental_kind::character) {
                return char_codec;
            }
            else if constexpr (K == schema::fundamental_kind::signed_character) {
                return signed_char_codec;
            }
            else if constexpr (K == schema::fundamental_kind::unsigned_character) {
                return unsigned_char_codec;
            }
            else if constexpr (K == schema::fundamental_kind::wide_character) {
                return wchar_codec;
            }
            else if constexpr (K == schema::fundamental_kind::char8) {
                return char8_codec;
            }
            else if constexpr (K == schema::fundamental_kind::char16) {
                return char16_codec;
            }
            else if constexpr (K == schema::fundamental_kind::char32) {
                return char32_codec;
            }
            else if constexpr (K == schema::fundamental_kind::byte) {
                return byte_codec;
            }
            else if constexpr (K == schema::fundamental_kind::string) {
                return string_codec;
            }
            else if constexpr (K == schema::fundamental_kind::monostate) {
                return monostate_codec;
            }
        }

        template<typename S, std::size_t... Is>
        static constexpr auto build_object(const S& schema, std::index_sequence<Is...>) {
            return tuple_codec(
                schema::named_codec{
                    build(std::get<Is>(schema.fields).schema),
                    std::get<Is>(schema.fields).name
                }...
            );
        }

        template<typename S, std::size_t... Is>
        static constexpr auto build_tuple(const S& schema, std::index_sequence<Is...>) {
            return tuple_codec(build(std::get<Is>(schema.elements))...);
        }

        template<typename S, std::size_t... Is>
        static constexpr auto build_variant(const S& schema, std::index_sequence<Is...>) {
            return variant_codec(build(std::get<Is>(schema.alternatives))...);
        }
    };

} // namespace schema_detail

/**
 * @brief Reconstruct a type-erased codec from a compile-time schema
 *
 * Walks the schema IR and builds a concrete muesli codec. Exact primitive
 * kinds reconstruct the matching provided codec type, while generic category
 * kinds map to canonical codecs.
 *
 * Object schemas produce named tuple codecs (using schema::named_codec)
 * so json_format emits JSON objects with the original key names.
 *
 * @tparam S A compile-time schema type (primitive_schema, object_schema, etc.)
 * @param schema The schema to build a codec from
 * @return A concrete muesli codec matching the schema primitive kinds
 *
 * @code
 * static constexpr auto s = muesli::make_schema(point::codec);
 * static constexpr auto c = muesli::make_codec(s);
 * // c is a tuple_codec of named int64 fields "x" and "y"
 * auto fmt = muesli::make_json_format<Backend>(c);
 * auto j = fmt.serialize(std::tuple{int64_t{10}, int64_t{20}});
 * // j == {"x": 10, "y": 20}
 * @endcode
 *
 * @see make_schema
 * @see schema::named_codec
 */
template<typename S>
constexpr auto make_codec(const S& schema) {
    return schema_detail::codec_builder::build(schema);
}

} // namespace muesli

