#pragma once

#include <muesli/schema/types>
#include <muesli/format/json_backend>

#include <string>
#include <tuple>
#include <type_traits>

namespace muesli {

namespace schema_detail {

    /**
     * @brief Converts compile-time schema IR to JSON Schema (draft 2020-12) DOM
     *
     * Recursively walks schema nodes and emits standard JSON Schema using a
     * JsonBackend. Each schema node maps to its canonical JSON Schema form:
     *
     * | Schema node        | JSON Schema output                                           |
     * |--------------------|--------------------------------------------------------------|
     * | boolean            | {"type": "boolean"}                                          |
     * | signed_integer     | {"type": "integer"}                                          |
     * | unsigned_integer   | {"type": "integer", "minimum": 0}                            |
     * | floating_point     | {"type": "number"}                                           |
     * | string             | {"type": "string"}                                           |
     * | monostate          | {"type": "null"}                                             |
     * | optional_schema    | {"oneOf": [inner, {"type": "null"}]}                         |
     * | array_schema       | {"type": "array", "items": {...}}                            |
     * | object_schema      | {"type": "object", "properties": {...}, "required": [...]}   |
     * | tuple_schema       | {"type": "array", "prefixItems": [...], "items": false}      |
     * | variant_schema     | {"oneOf": [...]}                                             |
     */
    struct json_schema_emitter {

        template<JsonBackend Backend, typename S>
        static auto emit(const S& schema) -> typename Backend::value_type {
            if constexpr (schema::is_primitive_v<S>) {
                return emit_primitive<Backend>(schema);
            }
            else if constexpr (schema::is_optional_v<S>) {
                return emit_optional<Backend>(schema);
            }
            else if constexpr (schema::is_array_v<S>) {
                return emit_array<Backend>(schema);
            }
            else if constexpr (schema::is_object_v<S>) {
                return emit_object<Backend>(schema);
            }
            else if constexpr (schema::is_tuple_v<S>) {
                return emit_tuple<Backend>(schema);
            }
            else if constexpr (schema::is_variant_v<S>) {
                return emit_variant<Backend>(schema);
            }
        }

    private:
        template<JsonBackend Backend, schema::fundamental_kind K>
        static auto emit_primitive(const schema::primitive_schema<K>&)
            -> typename Backend::value_type
        {
            auto obj = Backend::make_object();
            if constexpr (K == schema::fundamental_kind::boolean) {
                Backend::object_set(obj, "type", Backend::make_string("boolean"));
            }
            else if constexpr (K == schema::fundamental_kind::signed_integer) {
                Backend::object_set(obj, "type", Backend::make_string("integer"));
            }
            else if constexpr (K == schema::fundamental_kind::unsigned_integer) {
                Backend::object_set(obj, "type", Backend::make_string("integer"));
                Backend::object_set(obj, "minimum", Backend::make_int(0));
            }
            else if constexpr (K == schema::fundamental_kind::floating_point) {
                Backend::object_set(obj, "type", Backend::make_string("number"));
            }
            else if constexpr (K == schema::fundamental_kind::string) {
                Backend::object_set(obj, "type", Backend::make_string("string"));
            }
            else if constexpr (K == schema::fundamental_kind::monostate) {
                Backend::object_set(obj, "type", Backend::make_string("null"));
            }
            return obj;
        }

        template<JsonBackend Backend, typename Inner>
        static auto emit_optional(const schema::optional_schema<Inner>& schema)
            -> typename Backend::value_type
        {
            auto obj = Backend::make_object();
            auto choices = Backend::make_array();
            Backend::array_push_back(choices, emit<Backend>(schema.inner));
            auto null_schema = Backend::make_object();
            Backend::object_set(null_schema, "type", Backend::make_string("null"));
            Backend::array_push_back(choices, std::move(null_schema));
            Backend::object_set(obj, "oneOf", std::move(choices));
            return obj;
        }

        template<JsonBackend Backend, typename Element>
        static auto emit_array(const schema::array_schema<Element>& schema)
            -> typename Backend::value_type
        {
            auto obj = Backend::make_object();
            Backend::object_set(obj, "type", Backend::make_string("array"));
            Backend::object_set(obj, "items", emit<Backend>(schema.element));
            return obj;
        }

        template<JsonBackend Backend, typename... Fields>
        static auto emit_object(const schema::object_schema<Fields...>& schema)
            -> typename Backend::value_type
        {
            return emit_object_impl<Backend>(schema,
                std::make_index_sequence<sizeof...(Fields)>{});
        }

        template<JsonBackend Backend, typename S, std::size_t... Is>
        static auto emit_object_impl(const S& schema, std::index_sequence<Is...>)
            -> typename Backend::value_type
        {
            auto obj = Backend::make_object();
            Backend::object_set(obj, "type", Backend::make_string("object"));

            auto props = Backend::make_object();
            auto req = Backend::make_array();

            (emit_field<Backend>(props, req, std::get<Is>(schema.fields)), ...);

            Backend::object_set(obj, "properties", std::move(props));
            Backend::object_set(obj, "required", std::move(req));
            return obj;
        }

        template<JsonBackend Backend, typename Field>
        static void emit_field(typename Backend::value_type& props,
                               typename Backend::value_type& req,
                               const Field& field)
        {
            // For optional fields inside objects, emit the inner schema directly
            // (not wrapped in oneOf with null) — the field is simply not in "required"
            if constexpr (schema::is_optional_v<std::decay_t<decltype(field.schema)>>) {
                Backend::object_set(props, std::string(field.name),
                                    emit<Backend>(field.schema.inner));
            } else {
                Backend::object_set(props, std::string(field.name),
                                    emit<Backend>(field.schema));
            }
            if (field.required) {
                Backend::array_push_back(req, Backend::make_string(std::string(field.name)));
            }
        }

        template<JsonBackend Backend, typename... Elements>
        static auto emit_tuple(const schema::tuple_schema<Elements...>& schema)
            -> typename Backend::value_type
        {
            return emit_tuple_impl<Backend>(schema,
                std::make_index_sequence<sizeof...(Elements)>{});
        }

        template<JsonBackend Backend, typename S, std::size_t... Is>
        static auto emit_tuple_impl(const S& schema, std::index_sequence<Is...>)
            -> typename Backend::value_type
        {
            auto obj = Backend::make_object();
            Backend::object_set(obj, "type", Backend::make_string("array"));

            auto prefix = Backend::make_array();
            (Backend::array_push_back(prefix, emit<Backend>(std::get<Is>(schema.elements))), ...);
            Backend::object_set(obj, "prefixItems", std::move(prefix));

            Backend::object_set(obj, "items", Backend::make_bool(false));
            return obj;
        }

        template<JsonBackend Backend, typename... Alternatives>
        static auto emit_variant(const schema::variant_schema<Alternatives...>& schema)
            -> typename Backend::value_type
        {
            return emit_variant_impl<Backend>(schema,
                std::make_index_sequence<sizeof...(Alternatives)>{});
        }

        template<JsonBackend Backend, typename S, std::size_t... Is>
        static auto emit_variant_impl(const S& schema, std::index_sequence<Is...>)
            -> typename Backend::value_type
        {
            auto obj = Backend::make_object();
            auto choices = Backend::make_array();
            (Backend::array_push_back(choices, emit<Backend>(std::get<Is>(schema.alternatives))), ...);
            Backend::object_set(obj, "oneOf", std::move(choices));
            return obj;
        }
    };

} // namespace schema_detail

/**
 * @brief Convert a compile-time schema to a JSON Schema (draft 2020-12) DOM node
 *
 * Walks the schema IR and produces a standard JSON Schema document using
 * the given JsonBackend. The output can be serialised to a JSON string
 * using the backend's facilities.
 *
 * @tparam Backend A type satisfying the JsonBackend concept
 * @tparam S The compile-time schema type
 * @param schema The schema to convert
 * @return A JSON Schema DOM node
 *
 * @code
 * static constexpr auto s = muesli::make_schema(person::codec);
 * auto json_schema = muesli::to_json_schema<nlohmann_json_backend>(s);
 * // {"type":"object","properties":{"age":{"type":"integer"},...},...}
 * @endcode
 *
 * @see make_schema
 * @see JsonBackend
 */
template<JsonBackend Backend, typename S>
auto to_json_schema(const S& schema) -> typename Backend::value_type {
    return schema_detail::json_schema_emitter::emit<Backend>(schema);
}

} // namespace muesli

