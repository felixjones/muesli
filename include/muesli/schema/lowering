namespace muesli::schema {

// -------------------------------------------------------------------------
//  Type detection traits
// -------------------------------------------------------------------------

namespace lowering_detail {

    // identity_codec<T>
    template<typename> struct is_identity_codec : std::false_type {};
    template<typename T> struct is_identity_codec<identity_codec<T>> : std::true_type {};

    // constant_codec<T, V>
    template<typename> struct is_constant_codec : std::false_type {};
    template<typename T, T V> struct is_constant_codec<constant_codec<T, V>> : std::true_type {};

    // tuple_codec<Cs...>
    template<typename> struct is_tuple_codec : std::false_type {};
    template<typename... Cs> struct is_tuple_codec<tuple_codec<Cs...>> : std::true_type {};

    // pair_codec<C1, C2>
    template<typename> struct is_pair_codec : std::false_type {};
    template<typename C1, typename C2> struct is_pair_codec<pair_codec<C1, C2>> : std::true_type {};

    // variant_codec<Cs...>
    template<typename> struct is_variant_codec : std::false_type {};
    template<typename... Cs> struct is_variant_codec<variant_codec<Cs...>> : std::true_type {};

    // vector_codec<E, A>
    template<typename> struct is_vector_codec : std::false_type {};
    template<typename E, typename A> struct is_vector_codec<vector_codec<E, A>> : std::true_type {};

    // array_codec<E, N>
    template<typename> struct is_array_codec : std::false_type {};
    template<typename E, std::size_t N> struct is_array_codec<array_codec<E, N>> : std::true_type {};

    // delimited_codec<E, P>
    template<typename> struct is_delimited_codec : std::false_type {};
    template<typename E, typename P> struct is_delimited_codec<delimited_codec<E, P>> : std::true_type {};

    // transform_codec<I, Enc, Dec, V>
    template<typename> struct is_transform_codec : std::false_type {};
    template<typename I, typename E, typename D, typename V>
    struct is_transform_codec<transform_codec<I, E, D, V>> : std::true_type {};

    // apply_codec<A, V>
    template<typename> struct is_apply_codec : std::false_type {};
    template<Codec A, typename V> struct is_apply_codec<apply_codec<A, V>> : std::true_type {};

    // member_codec<F, M>
    template<typename> struct is_member_codec : std::false_type {};
    template<Codec F, auto M> struct is_member_codec<member_codec<F, M>> : std::true_type {};

    // named_member_codec<F, M>
    template<typename> struct is_named_member_codec : std::false_type {};
    template<Codec F, auto M> struct is_named_member_codec<named_member_codec<F, M>> : std::true_type {};

    // constrained_codec<I, P>
    template<typename> struct is_constrained_codec : std::false_type {};
    template<Codec I, typename P> struct is_constrained_codec<constrained_codec<I, P>> : std::true_type {};

    // or_else_codec<C, F>
    template<typename> struct is_or_else_codec : std::false_type {};
    template<typename C, typename F> struct is_or_else_codec<or_else_codec<C, F>> : std::true_type {};

    // projector_codec<O, F, P>
    template<typename> struct is_projector_codec : std::false_type {};
    template<typename O, Codec F, typename P>
    struct is_projector_codec<projector_codec<O, F, P>> : std::true_type {};

    // optional_codec<V>
    template<typename> struct is_optional_codec_trait : std::false_type {};
    template<Codec V> struct is_optional_codec_trait<optional_codec<V>> : std::true_type {};
    // Specialization for constrained optional
    template<Codec I, typename P>
    struct is_optional_codec_trait<optional_codec<constrained_codec<I, P>>> : std::true_type {};

    // range_codec<E>
    template<typename> struct is_range_codec : std::false_type {};
    template<typename E> struct is_range_codec<range_codec<E>> : std::true_type {};

    // Character type detection for delimiter inference
    template<typename T>
    inline constexpr bool is_char_type_v =
        std::same_as<T, char> || std::same_as<T, wchar_t> ||
        std::same_as<T, char8_t> || std::same_as<T, char16_t> || std::same_as<T, char32_t> ||
        std::same_as<T, signed char>;

    // Compute variant index_bytes to match binary_format logic exactly.
    // binary_format uses: variant_alignment_v (max alignof of alternatives)
    // and variant_alternative_count to pick uint8/16/32/64.
    template<typename... ValueTypes>
    constexpr std::uint8_t compute_variant_index_bytes() noexcept {
        constexpr std::size_t maxAlign = std::max({alignment_or_zero<ValueTypes>...});
        constexpr std::size_t altCount = sizeof...(ValueTypes);
        if constexpr (maxAlign <= 1 && altCount <= std::numeric_limits<std::uint8_t>::max())
            return 1;
        else if constexpr (maxAlign <= 2 && altCount <= std::numeric_limits<std::uint16_t>::max())
            return 2;
        else if constexpr (maxAlign <= 4 && altCount <= std::numeric_limits<std::uint32_t>::max())
            return 4;
        else
            return 8;
    }

} // namespace lowering_detail

// -------------------------------------------------------------------------
//  build_schema  --  the main lowering function
// -------------------------------------------------------------------------

/**
 * @brief Extracts a schema_node from a typed codec.
 *
 * Walks the compile-time codec chain and produces a canonical schema IR
 * tree describing the binary layout that binary_format would emit. Wrapper
 * codecs (transform, apply, member, constrained, or_else, projector,
 * optional) are transparent and lowered through.
 *
 * @tparam C Any type satisfying the Codec concept.
 * @param codec The codec instance.
 * @return A schema_node describing the binary layout.
 */
template<Codec C>
schema_node build_schema(const C& codec) {
    using codec_type = std::decay_t<C>;
    using value_type = typename codec_type::value_type;

    // -- Leaf: identity_codec<T> ------------------------------------------
    if constexpr (lowering_detail::is_identity_codec<codec_type>::value) {
        if constexpr (std::same_as<value_type, std::monostate>) {
            return schema_node{monostate_schema{}};
        } else {
            static_assert(std::is_fundamental_v<value_type> || std::is_same_v<value_type, std::byte>,
                          "build_schema: identity_codec wraps a non-fundamental type");
            return schema_node{fundamental_schema{
                static_cast<std::uint8_t>(sizeof(value_type)),
                static_cast<std::uint8_t>(alignof(value_type))
            }};
        }
    }
    // -- Leaf: constant_codec<T, V> (monostate is the common case) --------
    else if constexpr (lowering_detail::is_constant_codec<codec_type>::value) {
        if constexpr (std::same_as<value_type, std::monostate> || std::same_as<value_type, std::nullptr_t>) {
            return schema_node{monostate_schema{}};
        } else {
            return schema_node{fundamental_schema{
                static_cast<std::uint8_t>(sizeof(value_type)),
                static_cast<std::uint8_t>(alignof(value_type))
            }};
        }
    }
    // -- Composite: tuple_codec<Cs...> ------------------------------------
    else if constexpr (lowering_detail::is_tuple_codec<codec_type>::value) {
        return [&]<std::size_t... Is>(std::index_sequence<Is...>) {
            tuple_schema ts;
            ts.elements.reserve(sizeof...(Is));
            (ts.elements.push_back(
                make_node(build_schema(std::get<Is>(codec.codecs)))), ...);
            return schema_node{std::move(ts)};
        }(std::make_index_sequence<std::tuple_size_v<decltype(codec.codecs)>>{});
    }
    // -- Composite: pair_codec<C1, C2> ------------------------------------
    else if constexpr (lowering_detail::is_pair_codec<codec_type>::value) {
        // Delegate to the underlying tuple_codec
        return build_schema(codec.codec);
    }
    // -- Composite: variant_codec<Cs...> ----------------------------------
    else if constexpr (lowering_detail::is_variant_codec<codec_type>::value) {
        return [&]<std::size_t... Is>(std::index_sequence<Is...>) {
            variant_schema vs;
            vs.alternatives.reserve(sizeof...(Is));
            (vs.alternatives.push_back(
                make_node(build_schema(std::get<Is>(codec.codecs)))), ...);

            // Compute index_bytes matching binary_format logic
            using variant_t = typename codec_type::value_type;
            vs.index_bytes = [&]<typename... Ts>(const std::variant<Ts...>*) {
                return lowering_detail::compute_variant_index_bytes<Ts...>();
            }(static_cast<const variant_t*>(nullptr));

            return schema_node{std::move(vs)};
        }(std::make_index_sequence<std::tuple_size_v<decltype(codec.codecs)>>{});
    }
    // -- Container: vector_codec<E, A> ------------------------------------
    else if constexpr (lowering_detail::is_vector_codec<codec_type>::value) {
        vector_schema vs;
        vs.element = make_node(build_schema(codec.element_codec));
        vs.size_bytes = static_cast<std::uint8_t>(sizeof(std::size_t));
        vs.size_alignment = static_cast<std::uint8_t>(alignof(std::size_t));
        return schema_node{std::move(vs)};
    }
    // -- Container: array_codec<E, N> -------------------------------------
    else if constexpr (lowering_detail::is_array_codec<codec_type>::value) {
        constexpr std::size_t N = std::tuple_size_v<value_type>;
        array_schema as;
        as.element = make_node(build_schema(codec.element_codec));
        as.count = static_cast<std::uint32_t>(N);
        return schema_node{std::move(as)};
    }
    // -- Delimited: delimited_codec<E, P> ---------------------------------
    else if constexpr (lowering_detail::is_delimited_codec<codec_type>::value) {
        using elem_value_type = typename codec_type::element_value_type;
        static_assert(sizeof(elem_value_type) == 1,
                      "build_schema: v1 only supports single-byte delimited elements");

        delimited_schema ds;
        ds.element = make_node(build_schema(codec.element_codec));

        // Infer delimiter from element type
        if constexpr (lowering_detail::is_char_type_v<elem_value_type>) {
            // Null-terminated string: stop when byte == 0
            ds.delimiter_mask = 0xFF;
            ds.delimiter_expected = 0x00;
        } else {
            // Varint continuation-bit: stop when (byte & 0x80) == 0
            ds.delimiter_mask = 0x80;
            ds.delimiter_expected = 0x00;
        }

        return schema_node{std::move(ds)};
    }
    // -- Transparent wrappers: recurse into inner codec -------------------
    else if constexpr (lowering_detail::is_transform_codec<codec_type>::value) {
        return build_schema(codec.inner);
    }
    else if constexpr (lowering_detail::is_apply_codec<codec_type>::value) {
        return build_schema(codec.arg_codec);
    }
    else if constexpr (lowering_detail::is_member_codec<codec_type>::value) {
        return build_schema(codec.field_codec);
    }
    else if constexpr (lowering_detail::is_named_member_codec<codec_type>::value) {
        return build_schema(codec.field_codec);
    }
    else if constexpr (lowering_detail::is_constrained_codec<codec_type>::value) {
        return build_schema(codec.inner);
    }
    else if constexpr (lowering_detail::is_or_else_codec<codec_type>::value) {
        return build_schema(codec.inner);
    }
    else if constexpr (lowering_detail::is_projector_codec<codec_type>::value) {
        return build_schema(codec.field_codec);
    }
    else if constexpr (lowering_detail::is_optional_codec_trait<codec_type>::value) {
        // optional_codec lowers to its next_codec (variant_codec)
        return build_schema(codec.next_codec());
    }
    else if constexpr (lowering_detail::is_range_codec<codec_type>::value) {
        // Bare range_codec should not appear at top level; treat as array
        // with unknown count. This is a fallback -- callers should wrap
        // range_codec in vector_codec or array_codec.
        static_assert(lowering_detail::is_range_codec<codec_type>::value,
                      "build_schema: bare range_codec is not supported at top level");
    }
    else {
        static_assert(sizeof(codec_type) == 0,
                      "build_schema: unsupported codec type");
    }
}

} // namespace muesli::schema

