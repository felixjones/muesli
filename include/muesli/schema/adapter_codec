#pragma once

#include <muesli/format/binary_format>
#include <muesli/util/concepts>

#include <optional>
#include <sstream>
#include <string>

namespace muesli {

/**
 * @category Schema Codecs
 * @brief Bridges a schema-generated codec and an original typed codec via
 * binary serialization, enabling type-agnostic deserialization and schema
 * migration.
 *
 * A schema codec (produced by `make_codec(make_schema(c))`) operates on
 * canonical, type-erased values (tuples of primitives).  Its binary layout
 * is identical to the original codec's layout, which means bytes produced
 * by one can be consumed by the other.
 *
 * `schema_adapter_codec` exploits this property to convert between the two
 * value types:
 *
 *  - `decode(schema_val)` serializes the schema value to bytes with the
 *    schema codec, then deserializes those bytes with the original codec,
 *    producing the original typed value.
 *  - `encode(typed_val)` serializes the typed value to bytes with the
 *    original codec, then deserializes those bytes with the schema codec,
 *    producing the type-erased schema value.
 *
 * This enables a powerful migration workflow:
 *
 * @code
 * constexpr auto schema       = mu::make_schema(contact_codec);
 * constexpr auto schema_codec = mu::make_codec(schema);
 *
 * // Deserialize from disk using the schema codec (type-agnostic)
 * auto fmt_schema = mu::make_binary_format<char>(schema_codec);
 * auto agnostic   = from_bytes(fmt_schema, bytesFromDisk);
 *
 * // Upgrade / migrate agnostic here ...
 *
 * // Adapt the agnostic value back into the original typed struct
 * auto adapter = mu::make_schema_adapter(contact_codec, schema_codec);
 * auto typed   = adapter.decode(*agnostic);
 * @endcode
 *
 * @tparam OriginalCodec The original typed codec (e.g. `point::codec`)
 * @tparam SchemaCodec   The codec rebuilt from the schema IR
 *
 * @code
 * constexpr auto schema       = make_schema(point::codec);
 * constexpr auto schema_codec = make_codec(schema);
 * auto adapter = make_schema_adapter(point::codec, schema_codec);
 *
 * auto encoded = adapter.encode(point{10, 20});   // std::optional<schema_val>
 * auto decoded = adapter.decode(*encoded);         // std::optional<point>
 * assert(decoded && decoded->x == 10);
 * @endcode
 *
 * @see make_schema
 * @see make_codec
 */
template<Codec OriginalCodec, Codec SchemaCodec>
requires(!std::same_as<typename OriginalCodec::value_type,
                       typename SchemaCodec::value_type>)
struct schema_adapter_codec {
    /// @brief The original codec's value type (what we want to end up with)
    using value_type = typename OriginalCodec::value_type;
    /// @brief The intermediate schema-generated type
    using schema_value_type = typename SchemaCodec::value_type;

    /// @brief The original codec (for typed serialization)
    OriginalCodec original;
    /// @brief The schema codec (for type-erased serialization)
    SchemaCodec schema;

    /// @brief Constructs a schema adapter from both codecs
    constexpr schema_adapter_codec(
        const OriginalCodec& orig,
        const SchemaCodec& sch
    ) noexcept
        : original(orig), schema(sch) {}

    /**
     * @brief Adapt a type-agnostic schema value into the original typed value.
     *
     * Serializes @p schema_val to bytes via binary_format with the schema
     * codec, then deserializes those bytes with the original codec.
     *
     * @param schema_val The schema-typed value to adapt
     * @return The original typed value, or std::nullopt on failure
     */
    std::optional<value_type> decode(const schema_value_type& schema_val) const {
        std::stringstream ss(std::ios::in | std::ios::out | std::ios::binary);
        auto fmt_schema = make_binary_format<char>(schema);
        if (!fmt_schema.serialize(schema_val, ss)) {
            return std::nullopt;
        }
        std::istringstream iss(ss.str(), std::ios::binary);
        auto fmt_orig = make_binary_format<char>(original);
        return fmt_orig.deserialize(iss);
    }

    /**
     * @brief Adapt the original typed value into a type-agnostic schema value.
     *
     * Serializes @p value to bytes via binary_format with the original
     * codec, then deserializes those bytes with the schema codec.
     *
     * @param value The original typed value to adapt
     * @return The schema-typed value, or std::nullopt on failure
     */
    std::optional<schema_value_type> encode(const value_type& value) const {
        std::stringstream ss(std::ios::in | std::ios::out | std::ios::binary);
        auto fmt_orig = make_binary_format<char>(original);
        if (!fmt_orig.serialize(value, ss)) {
            return std::nullopt;
        }
        std::istringstream iss(ss.str(), std::ios::binary);
        auto fmt_schema = make_binary_format<char>(schema);
        return fmt_schema.deserialize(iss);
    }
};

/**
 * @brief Create a schema adapter codec
 *
 * Combines an original typed codec with a schema-generated codec into a
 * single adapter.  Because both codecs share the same binary layout, the
 * adapter can convert between the original typed value and the type-erased
 * schema value by round-tripping through binary serialization.
 *
 * @tparam OriginalCodec A Codec with value_type V
 * @tparam SchemaCodec   A Codec with different value_type (usually a tuple of
 *                       canonical primitives)
 * @param original The original typed codec
 * @param schema   The schema-generated codec
 * @return A `schema_adapter_codec` bridging both
 *
 * @code
 * constexpr auto schema       = make_schema(point::codec);
 * constexpr auto schema_codec = make_codec(schema);
 * auto adapter = make_schema_adapter(point::codec, schema_codec);
 *
 * // typed -> agnostic
 * auto agnostic = adapter.encode(point{10, 20});
 * // agnostic -> typed
 * auto typed = adapter.decode(*agnostic);
 * @endcode
 *
 * @see schema_adapter_codec
 */
template<Codec OriginalCodec, Codec SchemaCodec>
requires(!std::same_as<typename OriginalCodec::value_type,
                       typename SchemaCodec::value_type>)
constexpr auto make_schema_adapter(
    const OriginalCodec& original,
    const SchemaCodec& schema
) noexcept {
    return schema_adapter_codec<OriginalCodec, SchemaCodec>{original, schema};
}

} // namespace muesli

