namespace muesli {

// -- Named member detection traits ----------------------------------------

/** @brief Trait to detect if a codec has a member_name data member */
template<typename T, typename = void>
struct has_member_name : std::false_type {};

template<typename T>
struct has_member_name<T, std::void_t<decltype(std::declval<const T&>().member_name)>> : std::true_type {};

/** @brief Value template to detect if a codec has a member_name */
template<typename T>
inline constexpr bool has_member_name_v = has_member_name<T>::value;

namespace named_detail {

    /** @brief Check if all types in a tuple have member_name */
    template<typename Tuple>
    struct all_named_in_tuple;

    template<typename... Ts>
    struct all_named_in_tuple<std::tuple<Ts...>> : std::bool_constant<(has_member_name_v<Ts> && ...)> {};

    /** @brief Check if any type in a tuple has member_name */
    template<typename Tuple>
    struct any_named_in_tuple;

    template<typename... Ts>
    struct any_named_in_tuple<std::tuple<Ts...>> : std::bool_constant<(has_member_name_v<Ts> || ...)> {};

    /** @brief Helper to get a codec's member_name or empty string_view */
    template<typename T>
    constexpr std::string_view get_name_or_empty(const T& codec) {
        if constexpr (has_member_name_v<T>) {
            return codec.member_name;
        } else {
            return {};
        }
    }

    /** @brief Duplicate name detection on a tuple of codec instances */
    template<typename... Ts, std::size_t... Is>
    constexpr bool check_duplicate_names_impl(const std::tuple<Ts...>& codecs, std::index_sequence<Is...>) {
        const std::string_view names[] = { get_name_or_empty(std::get<Is>(codecs))... };
        constexpr std::size_t N = sizeof...(Ts);
        for (std::size_t i = 0; i < N; ++i) {
            if (names[i].empty()) continue;
            for (std::size_t j = i + 1; j < N; ++j) {
                if (names[i] == names[j]) return true;
            }
        }
        return false;
    }

} // namespace named_detail

/** @brief True if all codecs in a tuple type have member_name */
template<typename Tuple>
inline constexpr bool all_named_v = named_detail::all_named_in_tuple<Tuple>::value;

/** @brief True if any codec in a tuple type has member_name */
template<typename Tuple>
inline constexpr bool any_named_v = named_detail::any_named_in_tuple<Tuple>::value;

/** @brief True if no codecs in a tuple type have member_name */
template<typename Tuple>
inline constexpr bool none_named_v = !named_detail::any_named_in_tuple<Tuple>::value;

/**
 * @brief Checks whether a tuple of codecs contains duplicate member names
 *
 * Works on codec tuple instances. Since codecs are typically declared as
 * `static constexpr`, this is effectively evaluated at compile time.
 *
 * @code
 * static_assert(!muesli::has_duplicate_names(person::codec.arg_codec.codecs));
 * @endcode
 */
template<typename... Ts>
constexpr bool has_duplicate_names(const std::tuple<Ts...>& codecs) {
    if constexpr (sizeof...(Ts) <= 1) {
        return false;
    } else {
        return named_detail::check_duplicate_names_impl(codecs, std::index_sequence_for<Ts...>{});
    }
}

/** @brief Forward declaration of range_holder utility type */
template<typename T>
struct range_holder;

/** @brief Helper constant for alignment, returns 0 for monostate */
template<typename T>
constexpr std::size_t alignment_or_zero = std::same_as<T, std::monostate> ? 0 : alignof(T);

/** @brief Trait to compute alignment of a variant type */
template<typename T>
struct variant_alignment;

/** @brief Specialisation for std::variant - returns max alignment of alternatives */
template<typename... Ts>
struct variant_alignment<std::variant<Ts...>> {
    static constexpr std::size_t value = std::max({alignment_or_zero<Ts>...});
};

/** @brief Value template for variant alignment */
template<typename T>
inline constexpr std::size_t variant_alignment_v = variant_alignment<T>::value;

/** @brief Trait to detect std::optional types */
template<typename>
struct is_optional : std::false_type {};

/** @brief Specialisation for std::optional */
template<typename T>
struct is_optional<std::optional<T>> : std::true_type {};

/** @brief Value template to detect std::optional types */
template<typename T>
inline constexpr bool is_optional_v = is_optional<T>::value;

/** @brief Trait to detect std::tuple types */
template<typename>
struct is_tuple : std::false_type {};

/** @brief Specialisation for std::tuple */
template<typename... Ts>
struct is_tuple<std::tuple<Ts...>> : std::true_type {};

/** @brief Value template to detect std::tuple types */
template<typename T>
inline constexpr bool is_tuple_v = is_tuple<T>::value;

/** @brief Trait to detect range_holder types */
template<typename>
struct is_range_holder : std::false_type {};

/** @brief Specialisation for range_holder */
template<typename T>
struct is_range_holder<range_holder<T>> : std::true_type {};

/** @brief Value template to detect range_holder types */
template<typename T>
inline constexpr bool is_range_holder_v = is_range_holder<T>::value;

/** @brief Trait to detect move-only types (move constructible but not copy constructible) */
template<typename T>
struct is_move_only : std::bool_constant<std::move_constructible<T> && !std::copy_constructible<T>> {};

/** @brief Value template to detect move-only types */
template<typename T>
inline constexpr bool is_move_only_v = is_move_only<T>::value;

/** @brief Trait to extract owner and member types from pointers-to-members and member functions */
template<typename>
struct member_pointer_traits;

/** @brief Specialisation for data member pointers (T Owner::*) */
template<typename Owner, typename Member>
struct member_pointer_traits<Member Owner::*> {
    using owner_type = Owner;
    using member_type = Member;
};

/** @brief Specialisation for member function pointers with no arguments */
template<typename Owner, typename R>
struct member_pointer_traits<R (Owner::*)()> {
    using owner_type = Owner;
    using member_type = R;
};

/** @brief Specialisation for const member function pointers with no arguments */
template<typename Owner, typename R>
struct member_pointer_traits<R (Owner::*)() const> {
    using owner_type = Owner;
    using member_type = R;
};

/** @brief Specialisation for noexcept member function pointers */
template<typename Owner, typename R>
struct member_pointer_traits<R (Owner::*)() noexcept> : member_pointer_traits<R (Owner::*)()> {};

/** @brief Specialisation for const noexcept member function pointers */
template<typename Owner, typename R>
struct member_pointer_traits<R (Owner::*)() const noexcept> : member_pointer_traits<R (Owner::*)() const> {};

} // namespace muesli
