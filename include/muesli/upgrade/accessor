#pragma once

#include <muesli/upgrade/types>

#include <cstddef>
#include <cstdint>
#include <optional>
#include <sstream>
#include <string>
#include <tuple>
#include <type_traits>
#include <variant>

namespace muesli::upgrade {

namespace accessor_detail {

    template<typename T> struct is_optional : std::false_type {};
    template<typename U> struct is_optional<std::optional<U>> : std::true_type {};
    template<typename T> inline constexpr bool is_optional_v = is_optional<T>::value;

    /**
     * @brief Convert a tuple element to a literal for generic read access.
     */
    template<typename T>
    literal to_literal(const T& value) {
        if constexpr (is_optional_v<T>) {
            if (value.has_value()) {
                return to_literal(*value);
            }
            return literal{std::monostate{}};
        } else if constexpr (std::is_same_v<T, bool>) {
            return literal{value};
        } else if constexpr (std::is_same_v<T, std::string>) {
            return literal{value};
        } else if constexpr (std::is_signed_v<T> && std::is_integral_v<T>) {
            return literal{static_cast<std::int64_t>(value)};
        } else if constexpr (std::is_unsigned_v<T> && std::is_integral_v<T>) {
            return literal{static_cast<std::uint64_t>(value)};
        } else if constexpr (std::is_floating_point_v<T>) {
            return literal{static_cast<double>(value)};
        } else if constexpr (std::is_same_v<T, std::monostate>) {
            return literal{std::monostate{}};
        } else {
            return literal{std::monostate{}};
        }
    }

    /**
     * @brief Assign a literal into a tuple element, with appropriate conversion.
     * @return true if assignment succeeded
     */
    template<typename T>
    bool from_literal(T& dest, const literal& lit) {
        if constexpr (is_optional_v<T>) {
            if (std::holds_alternative<std::monostate>(lit)) {
                dest = std::nullopt;
                return true;
            }
            typename T::value_type inner{};
            if (from_literal(inner, lit)) {
                dest = std::move(inner);
                return true;
            }
            return false;
        } else if constexpr (std::is_same_v<T, bool>) {
            if (const auto* p = std::get_if<bool>(&lit)) { dest = *p; return true; }
        } else if constexpr (std::is_same_v<T, std::string>) {
            if (const auto* p = std::get_if<std::string>(&lit)) { dest = *p; return true; }
        } else if constexpr (std::is_signed_v<T> && std::is_integral_v<T>) {
            if (const auto* p = std::get_if<std::int64_t>(&lit)) { dest = static_cast<T>(*p); return true; }
            if (const auto* p = std::get_if<std::uint64_t>(&lit)) { dest = static_cast<T>(*p); return true; }
        } else if constexpr (std::is_unsigned_v<T> && std::is_integral_v<T>) {
            if (const auto* p = std::get_if<std::uint64_t>(&lit)) { dest = static_cast<T>(*p); return true; }
            if (const auto* p = std::get_if<std::int64_t>(&lit)) { dest = static_cast<T>(*p); return true; }
        } else if constexpr (std::is_floating_point_v<T>) {
            if (const auto* p = std::get_if<double>(&lit)) { dest = static_cast<T>(*p); return true; }
        }
        return false;
    }

    /**
     * @brief Convert a tuple element to its string representation for template substitution.
     */
    template<typename T>
    std::string to_string(const T& value) {
        if constexpr (is_optional_v<T>) {
            if (value.has_value()) {
                return to_string(*value);
            }
            return "";
        } else if constexpr (std::is_same_v<T, std::string>) {
            return value;
        } else if constexpr (std::is_same_v<T, bool>) {
            return value ? "true" : "false";
        } else if constexpr (std::is_arithmetic_v<T>) {
            std::ostringstream oss;
            oss << value;
            return oss.str();
        } else if constexpr (std::is_same_v<T, std::monostate>) {
            return "";
        } else {
            return "";
        }
    }

    /**
     * @brief Runtime-indexed get: read tuple element at `idx` as a literal.
     */
    template<typename Tuple, std::size_t... Is>
    std::optional<literal> get_at(const Tuple& t, std::size_t idx, std::index_sequence<Is...>) {
        std::optional<literal> result;
        ((Is == idx ? (result = to_literal(std::get<Is>(t)), true) : false) || ...);
        return result;
    }

    /**
     * @brief Runtime-indexed set: write a literal into tuple element at `idx`.
     */
    template<typename Tuple, std::size_t... Is>
    bool set_at(Tuple& t, std::size_t idx, const literal& lit, std::index_sequence<Is...>) {
        bool ok = false;
        ((Is == idx ? (ok = from_literal(std::get<Is>(t), lit), true) : false) || ...);
        return ok;
    }

    /**
     * @brief Runtime-indexed stringify: convert tuple element at `idx` to a string.
     */
    template<typename Tuple, std::size_t... Is>
    std::string stringify_at(const Tuple& t, std::size_t idx, std::index_sequence<Is...>) {
        std::string result;
        ((Is == idx ? (result = to_string(std::get<Is>(t)), true) : false) || ...);
        return result;
    }

} // namespace accessor_detail

/**
 * @brief Read a tuple element by runtime index, returning it as a literal.
 * @tparam Tuple A std::tuple-like type
 * @param t The tuple to read from
 * @param idx Zero-based element index
 * @return The element as a literal, or nullopt if index is out of range
 *
 * @code
 * auto val = tuple_get(my_tuple, 1);  // read element 1
 * @endcode
 */
template<typename Tuple>
std::optional<literal> tuple_get(const Tuple& t, std::size_t idx) {
    constexpr auto N = std::tuple_size_v<std::decay_t<Tuple>>;
    if (idx >= N) return std::nullopt;
    return accessor_detail::get_at(t, idx, std::make_index_sequence<N>{});
}

/**
 * @brief Write a literal into a tuple element by runtime index.
 * @tparam Tuple A std::tuple-like type
 * @param t The tuple to write into
 * @param idx Zero-based element index
 * @param lit The literal value to assign
 * @return true if the assignment succeeded
 *
 * @code
 * tuple_set(my_tuple, 0, literal{std::int64_t{42}});
 * @endcode
 */
template<typename Tuple>
bool tuple_set(Tuple& t, std::size_t idx, const literal& lit) {
    constexpr auto N = std::tuple_size_v<std::decay_t<Tuple>>;
    if (idx >= N) return false;
    return accessor_detail::set_at(t, idx, lit, std::make_index_sequence<N>{});
}

/**
 * @brief Convert a tuple element to a string by runtime index.
 * @tparam Tuple A std::tuple-like type
 * @param t The tuple to read from
 * @param idx Zero-based element index
 * @return The string representation of the element
 *
 * @code
 * auto s = tuple_stringify(my_tuple, 1);  // "michael"
 * @endcode
 */
template<typename Tuple>
std::string tuple_stringify(const Tuple& t, std::size_t idx) {
    constexpr auto N = std::tuple_size_v<std::decay_t<Tuple>>;
    if (idx >= N) return "";
    return accessor_detail::stringify_at(t, idx, std::make_index_sequence<N>{});
}

} // namespace muesli::upgrade
