#pragma once

#include <muesli/upgrade/types>

#include <functional>
#include <string>
#include <utility>

namespace muesli::upgrade {

/**
 * @brief Helper to construct a field reference argument.
 * @param source_path Path tokens to reference
 * @return argument_value containing a field_reference
 *
 * @code
 * up::ref_arg({std::size_t{1}})  // reference tuple element 1
 * @endcode
 */
inline argument_value ref_arg(std::vector<path_token> source_path) {
    return field_reference{std::move(source_path)};
}

/**
 * @brief Helper to construct a literal argument.
 * @tparam T Literal type
 * @param lit Literal value
 * @return argument_value containing the literal
 */
template<typename T>
inline argument_value lit_arg(T lit) {
    if constexpr (std::is_constructible_v<literal, T>) {
        return literal{lit};
    } else {
        static_assert(sizeof(T) == 0, "Type not convertible to literal");
    }
}

/**
 * @brief Make a step argument with a literal value.
 */
inline step_argument arg(std::string name, literal value) {
    return step_argument{std::move(name), value};
}

/**
 * @brief Make a step argument with a field reference.
 */
inline step_argument arg(std::string name, field_reference ref) {
    return step_argument{std::move(name), ref};
}

/**
 * @brief Make a step argument with any argument_value.
 */
inline step_argument arg(std::string name, argument_value value) {
    return step_argument{std::move(name), std::move(value)};
}

/**
 * @brief Extract a literal value from an argument (if it's a literal, not a reference).
 * @tparam T Requested literal type
 */
template<typename T>
std::optional<T> get_literal_as(const step_argument& arg) {
    const auto* lit = std::get_if<literal>(&arg.value);
    if (lit == nullptr) {
        return std::nullopt;
    }
    if (const auto* ptr = std::get_if<T>(lit)) {
        return *ptr;
    }
    return std::nullopt;
}

/**
 * @brief Check whether an argument is a field reference.
 */
inline bool is_field_reference(const step_argument& arg) {
    return std::get_if<field_reference>(&arg.value) != nullptr;
}

/**
 * @brief Get a field reference from an argument (if present).
 */
inline const field_reference* get_field_reference(const step_argument& arg) {
    return std::get_if<field_reference>(&arg.value);
}

} // namespace muesli::upgrade
