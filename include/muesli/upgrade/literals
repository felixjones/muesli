#pragma once

#include <muesli/upgrade/types>

#include <concepts>
#include <cstddef>
#include <cstdint>
#include <string>
#include <string_view>
#include <utility>
#include <vector>

namespace muesli::upgrade::literals {

/**
 * @brief Argument binder that creates a step_argument when bound to a value.
 *
 * This allows a fluent syntax like:
 * @code
 * "value"_arg(42)
 * "template"_arg("hello")
 * "source"_arg(idx(0))
 * @endcode
 */
class argument_binder {
public:
    constexpr explicit argument_binder(std::string_view name) noexcept
        : m_name(name) {}

    /**
     * @brief Bind a literal value to this argument.
     */
    inline step_argument operator()(argument_value value) const {
        return step_argument{std::string(m_name), std::move(value)};
    }

    /**
     * @brief Bind a signed integral value as an std::int64_t literal argument.
     */
    template<std::signed_integral T>
    requires (!std::same_as<T, bool>)
    inline step_argument operator()(T value) const {
        return step_argument{std::string(m_name), literal{static_cast<std::int64_t>(value)}};
    }

    /**
     * @brief Bind an unsigned integral value as an std::uint64_t literal argument.
     */
    template<std::unsigned_integral T>
    requires (!std::same_as<T, bool>)
    inline step_argument operator()(T value) const {
        return step_argument{std::string(m_name), literal{static_cast<std::uint64_t>(value)}};
    }

    /**
     * @brief Bind a floating-point value as a double literal argument.
     */
    template<std::floating_point T>
    inline step_argument operator()(T value) const {
        return step_argument{std::string(m_name), literal{static_cast<double>(value)}};
    }

    /**
     * @brief Bind a boolean value as a bool literal argument.
     */
    inline step_argument operator()(bool value) const {
        return step_argument{std::string(m_name), literal{value}};
    }

    /**
     * @brief Bind a C-string as a std::string literal argument.
     */
    inline step_argument operator()(const char* value) const {
        return step_argument{std::string(m_name), literal{std::string(value != nullptr ? value : "")}};
    }

    /**
     * @brief Bind a std::string_view as a std::string literal argument.
     */
    inline step_argument operator()(std::string_view value) const {
        return step_argument{std::string(m_name), literal{std::string(value)}};
    }

    /**
     * @brief Bind a std::string as a std::string literal argument.
     */
    inline step_argument operator()(const std::string& value) const {
        return step_argument{std::string(m_name), literal{value}};
    }

    /**
     * @brief Bind a literal value using operator=.
     */
    inline step_argument operator=(argument_value value) const {
        return step_argument{std::string(m_name), std::move(value)};
    }

    /**
     * @brief Bind a signed integral value as an std::int64_t literal argument using operator=.
     */
    template<std::signed_integral T>
    requires (!std::same_as<T, bool>)
    inline step_argument operator=(T value) const {
        return step_argument{std::string(m_name), literal{static_cast<std::int64_t>(value)}};
    }

    /**
     * @brief Bind an unsigned integral value as an std::uint64_t literal argument using operator=.
     */
    template<std::unsigned_integral T>
    requires (!std::same_as<T, bool>)
    inline step_argument operator=(T value) const {
        return step_argument{std::string(m_name), literal{static_cast<std::uint64_t>(value)}};
    }

    /**
     * @brief Bind a floating-point value as a double literal argument using operator=.
     */
    template<std::floating_point T>
    inline step_argument operator=(T value) const {
        return step_argument{std::string(m_name), literal{static_cast<double>(value)}};
    }

    /**
     * @brief Bind a boolean value as a bool literal argument using operator=.
     */
    inline step_argument operator=(bool value) const {
        return step_argument{std::string(m_name), literal{value}};
    }

    /**
     * @brief Bind a C-string as a std::string literal argument using operator=.
     */
    inline step_argument operator=(const char* value) const {
        return step_argument{std::string(m_name), literal{std::string(value != nullptr ? value : "")}};
    }

    /**
     * @brief Bind a std::string_view as a std::string literal argument using operator=.
     */
    inline step_argument operator=(std::string_view value) const {
        return step_argument{std::string(m_name), literal{std::string(value)}};
    }

    /**
     * @brief Bind a std::string as a std::string literal argument using operator=.
     */
    inline step_argument operator=(const std::string& value) const {
        return step_argument{std::string(m_name), literal{value}};
    }

private:
    std::string_view m_name;
};

/**
 * @brief UDL for creating an argument binder.
 *
 * @code
 * "count"_arg(42)                  // Bind 42 to "count"
 * "template"_arg("msg")             // Bind string to "template"
 * "source"_arg(idx(0))             // Bind field reference to "source"
 * @endcode
 */
constexpr inline argument_binder operator""_arg(const char* name, std::size_t len) noexcept {
    return argument_binder(std::string_view(name, len));
}

/**
 * @brief User-defined literal for std::int64_t arguments.
 * @param value The integer value
 * @return argument_value containing the literal
 *
 * @code
 * "count"_arg(42_i64)
 * @endcode
 */
constexpr inline argument_value operator""_i64(unsigned long long value) noexcept {
    return literal{static_cast<std::int64_t>(value)};
}

/**
 * @brief User-defined literal for std::uint64_t arguments.
 * @param value The unsigned integer value
 * @return argument_value containing the literal
 *
 * @code
 * "count"_arg(42_u64)
 * @endcode
 */
constexpr inline argument_value operator""_u64(unsigned long long value) noexcept {
    return literal{static_cast<std::uint64_t>(value)};
}

/**
 * @brief User-defined literal for double arguments.
 * @param value The floating-point value
 * @return argument_value containing the literal
 *
 * @code
 * "factor"_arg(3.14_f64)
 * @endcode
 */
constexpr inline argument_value operator""_f64(long double value) noexcept {
    return literal{static_cast<double>(value)};
}

/**
 * @brief User-defined literal for std::string arguments.
 * @param str The string value
 * @param len The string length
 * @return argument_value containing the literal string
 *
 * @code
 * "template"_arg("hello {world}"_str)
 * @endcode
 */
inline argument_value operator""_str(const char* str, std::size_t len) noexcept {
    return literal{std::string(str, len)};
}

/**
 * @brief Create a path reference to a tuple/array element.
 * @param index Zero-based index
 * @return argument_value containing a field_reference to that index
 *
 * @code
 * "source"_arg(idx(0))             // reference element 0
 * @endcode
 */
constexpr inline argument_value idx(std::size_t index) noexcept {
    return field_reference{std::vector<path_token>{index}};
}

/**
 * @brief Create a path reference to an object/map key.
 * @param key The field name
 * @return argument_value containing a field_reference to that key
 *
 * @code
 * "source"_arg(key("username"))    // reference object field
 * @endcode
 */
inline argument_value key(std::string_view key_name) {
    return field_reference{std::vector<path_token>{std::string(key_name)}};
}

/**
 * @brief Create a nested path reference (e.g., object.array[0].field).
 * @param tokens Sequence of path tokens (mix of strings and indices)
 * @return argument_value containing a field_reference to that path
 *
 * @code
 * "source"_arg(path({std::string("user"), std::size_t(0), std::string("email")}))
 * @endcode
 */
inline argument_value path(std::vector<path_token> tokens) {
    return field_reference{std::move(tokens)};
}

}  // namespace muesli::upgrade::literals
