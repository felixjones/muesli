#pragma once

#include <muesli/upgrade/concepts>
#include <muesli/upgrade/plan>
#include <muesli/upgrade/registry>
#include <muesli/upgrade/types>

#include <optional>
#include <vector>

namespace muesli::upgrade {

/**
 * @brief Apply a planned migration chain to an agnostic value.
 *
 * @tparam AgnosticValue The agnostic value type
 * @tparam Version User-defined version type
 * @param value Input agnostic value
 * @param documents Migration documents
 * @param path Document indices returned by find_upgrade_path
 * @param registry Operation registry
 * @return Upgraded value when all operations succeed
 */
template<typename AgnosticValue, typename Version>
std::optional<AgnosticValue> apply_upgrade_path(const AgnosticValue& value,
                                                const std::vector<upgrader_document<Version>>& documents,
                                                const std::vector<std::size_t>& path,
                                                const operation_registry<AgnosticValue>& registry) {
    AgnosticValue upgraded = value;

    for (const auto docIndex : path) {
        if (docIndex >= documents.size()) {
            return std::nullopt;
        }

        const auto& doc = documents[docIndex];
        for (const auto& step : doc.steps) {
            if (!registry.apply_step(step, upgraded)) {
                return std::nullopt;
            }
        }
    }

    return upgraded;
}

/**
 * @brief Find and apply a migration chain from one explicit version to another.
 *
 * @tparam AgnosticValue The agnostic value type
 * @tparam Version User-defined version type
 * @tparam Comparator User-provided version comparator
 * @param value Input agnostic value
 * @param documents Migration documents
 * @param from_version Source version
 * @param to_version Target version
 * @param cmp Version comparator
 * @param registry Operation registry
 * @return Upgraded value when planning and execution both succeed
 */
template<typename AgnosticValue, typename Version, typename Comparator>
requires version_comparator<Comparator, Version>
std::optional<AgnosticValue> apply_upgrades(const AgnosticValue& value,
                                            const std::vector<upgrader_document<Version>>& documents,
                                            const Version& from_version,
                                            const Version& to_version,
                                            const Comparator& cmp,
                                            const operation_registry<AgnosticValue>& registry) {
    auto path = find_upgrade_path(documents, from_version, to_version, cmp);
    if (!path.has_value()) {
        return std::nullopt;
    }

    return apply_upgrade_path(value, documents, *path, registry);
}

} // namespace muesli::upgrade
