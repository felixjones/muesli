#pragma once

#include <muesli/upgrade/types>

#include <functional>
#include <string>
#include <unordered_map>
#include <utility>

namespace muesli::upgrade {

/**
 * @brief Runtime registry for declarative upgrader operations.
 *
 * Each operation is identified by an operation id (`upgrader_step::op_id`) and
 * receives the mutable agnostic value plus the declarative step payload.
 *
 * @tparam AgnosticValue The agnostic value type being upgraded
 */
template<typename AgnosticValue>
struct operation_registry {
    /** @brief Function signature for an upgrade operation. */
    using operation_type = std::function<bool(AgnosticValue&, const upgrader_step&)>;

    /**
     * @brief Register an operation id.
     * @param id Operation identifier
     * @param op Callable implementation
     * @return true if inserted, false when id already exists
     */
    bool register_operation(std::string id, operation_type op) {
        auto [it, inserted] = m_operations.emplace(std::move(id), std::move(op));
        (void)it;
        return inserted;
    }

    /**
     * @brief Check whether an operation id is registered.
     * @param id Operation identifier
     * @return true when present
     */
    [[nodiscard]] bool has_operation(const std::string& id) const {
        return m_operations.find(id) != m_operations.end();
    }

    /**
     * @brief Apply one declarative step.
     * @param step Step payload
     * @param value Mutable agnostic value to transform
     * @return true on success
     */
    bool apply_step(const upgrader_step& step, AgnosticValue& value) const {
        const auto it = m_operations.find(step.op_id);
        if (it == m_operations.end()) {
            return false;
        }

        return static_cast<bool>(it->second(value, step));
    }

private:
    std::unordered_map<std::string, operation_type> m_operations;
};

} // namespace muesli::upgrade
