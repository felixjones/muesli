#pragma once

#include <muesli/upgrade/accessor>
#include <muesli/upgrade/helpers>
#include <muesli/upgrade/registry>
#include <muesli/upgrade/types>

#include <string>
#include <tuple>

namespace muesli::upgrade {

/**
 * @brief Generic built-in upgrade operations for tuple-based agnostic values.
 *
 * These operations work on any `std::tuple`-like agnostic value type produced
 * by `make_codec(schema)`. They use runtime-indexed tuple accessors so the user
 * never needs to write operation lambdas for common migration patterns.
 *
 * @tparam AgnosticValue A std::tuple-like type (e.g. from schema make_codec)
 *
 * @code
 * up::operation_registry<agnostic_value> registry;
 * up::register_builtins(registry);
 *
 * // Then just declare steps -- no lambdas!
 * up::upgrader_step{"set", {std::size_t{0}}, {"value"_arg(2)}}
 * up::upgrader_step{"format", {std::size_t{2}}, {"template"_arg("{1}@example.com")}}
 * @endcode
 */

/**
 * @brief Register the "set" operation.
 *
 * Sets the tuple element at `target_path[0]` to the literal in argument "value".
 *
 * @code
 * up::upgrader_step{"set", {std::size_t{0}}, {"value"_arg(2)}}
 * @endcode
 */
template<typename AgnosticValue>
bool register_set(operation_registry<AgnosticValue>& registry) {
    return registry.register_operation("set", [](AgnosticValue& value, const upgrader_step& step) -> bool {
        if (step.target_path.size() != 1) return false;
        const auto* idx = std::get_if<std::size_t>(&step.target_path[0]);
        if (idx == nullptr) return false;

        const auto lit_val = get_argument_as<std::int64_t>(step, "value");
        if (lit_val.has_value()) return tuple_set(value, *idx, literal{*lit_val});

        const auto uint_val = get_argument_as<std::uint64_t>(step, "value");
        if (uint_val.has_value()) return tuple_set(value, *idx, literal{*uint_val});

        const auto dbl_val = get_argument_as<double>(step, "value");
        if (dbl_val.has_value()) return tuple_set(value, *idx, literal{*dbl_val});

        const auto str_val = get_argument_as<std::string>(step, "value");
        if (str_val.has_value()) return tuple_set(value, *idx, literal{*str_val});

        const auto bool_val = get_argument_as<bool>(step, "value");
        if (bool_val.has_value()) return tuple_set(value, *idx, literal{*bool_val});

        return false;
    });
}

/**
 * @brief Register the "copy" operation.
 *
 * Copies the value at the source field reference into the element at `target_path[0]`.
 * Expects argument "source" as a field_reference with a single index.
 *
 * @code
 * up::upgrader_step{"copy", {std::size_t{2}}, {"source"_arg(idx(1))}}
 * @endcode
 */
template<typename AgnosticValue>
bool register_copy(operation_registry<AgnosticValue>& registry) {
    return registry.register_operation("copy", [](AgnosticValue& value, const upgrader_step& step) -> bool {
        if (step.target_path.size() != 1) return false;
        const auto* dst_idx = std::get_if<std::size_t>(&step.target_path[0]);
        if (dst_idx == nullptr) return false;

        const auto* source_arg = find_argument(step, "source");
        if (source_arg == nullptr) return false;

        const auto* ref = get_field_reference(*source_arg);
        if (ref == nullptr || ref->source_path.size() != 1) return false;

        const auto* src_idx = std::get_if<std::size_t>(&ref->source_path[0]);
        if (src_idx == nullptr) return false;

        auto src_lit = tuple_get(value, *src_idx);
        if (!src_lit.has_value()) return false;

        return tuple_set(value, *dst_idx, *src_lit);
    });
}

/**
 * @brief Register the "format" operation.
 *
 * Builds a string from a template with `{N}` placeholders (where N is a tuple
 * index) and writes the result to the element at `target_path[0]`.
 *
 * Placeholders are substituted with the string representation of the
 * corresponding tuple element.
 *
 * @code
 * // If element 1 is "michael", produces "michael@example.com"
 * up::upgrader_step{"format", {std::size_t{2}}, {"template"_arg("{1}@example.com")}}
 * @endcode
 */
template<typename AgnosticValue>
bool register_format(operation_registry<AgnosticValue>& registry) {
    return registry.register_operation("format", [](AgnosticValue& value, const upgrader_step& step) -> bool {
        if (step.target_path.size() != 1) return false;
        const auto* dst_idx = std::get_if<std::size_t>(&step.target_path[0]);
        if (dst_idx == nullptr) return false;

        const auto tmpl = get_argument_as<std::string>(step, "template");
        if (!tmpl.has_value()) return false;

        std::string result = *tmpl;
        std::size_t pos = 0;
        while ((pos = result.find('{', pos)) != std::string::npos) {
            const auto end = result.find('}', pos);
            if (end == std::string::npos) break;

            const auto token = result.substr(pos + 1, end - pos - 1);

            // Try numeric index
            std::size_t field_idx = 0;
            bool is_numeric = !token.empty();
            for (const auto ch : token) {
                if (ch < '0' || ch > '9') { is_numeric = false; break; }
                field_idx = field_idx * 10 + static_cast<std::size_t>(ch - '0');
            }

            if (is_numeric) {
                const auto replacement = tuple_stringify(value, field_idx);
                result.replace(pos, end - pos + 1, replacement);
                pos += replacement.length();
            } else {
                pos = end + 1;
            }
        }

        return tuple_set(value, *dst_idx, literal{result});
    });
}

/**
 * @brief Register the "remove" operation.
 *
 * Sets the tuple element at `target_path[0]` to its default/empty state.
 * For strings this clears to "", for numerics to 0, for bools to false.
 *
 * @code
 * up::upgrader_step{"remove", {std::size_t{2}}, {}}
 * @endcode
 */
template<typename AgnosticValue>
bool register_remove(operation_registry<AgnosticValue>& registry) {
    return registry.register_operation("remove", [](AgnosticValue& value, const upgrader_step& step) -> bool {
        if (step.target_path.size() != 1) return false;
        const auto* idx = std::get_if<std::size_t>(&step.target_path[0]);
        if (idx == nullptr) return false;

        // Try string first (empty), then int (0), then bool (false)
        if (tuple_set(value, *idx, literal{std::string{}})) return true;
        if (tuple_set(value, *idx, literal{std::int64_t{0}})) return true;
        if (tuple_set(value, *idx, literal{false})) return true;
        if (tuple_set(value, *idx, literal{std::monostate{}})) return true;
        return false;
    });
}

/**
 * @brief Register all built-in operations at once.
 *
 * Registers: "set", "copy", "format", "remove".
 *
 * @code
 * up::operation_registry<agnostic_value> registry;
 * up::register_builtins(registry);
 * @endcode
 */
template<typename AgnosticValue>
void register_builtins(operation_registry<AgnosticValue>& registry) {
    register_set(registry);
    register_copy(registry);
    register_format(registry);
    register_remove(registry);
}

} // namespace muesli::upgrade
