#pragma once

#include <cstddef>
#include <cstdint>
#include <optional>
#include <string>
#include <string_view>
#include <utility>
#include <variant>
#include <vector>

namespace muesli::upgrade {

/**
 * @brief One token in a target path inside an agnostic value.
 *
 * String tokens address object/map keys. Integer tokens address tuple/array
 * positions.
 */
using path_token = std::variant<std::string, std::size_t>;

/** @brief Primitive literal argument payload for declarative upgrader steps. */
using literal = std::variant<std::monostate, bool, std::int64_t, std::uint64_t, double, std::string>;

/**
 * @brief Reference to a field in the agnostic value (by path).
 *
 * Allows upgrade steps to derive values from other fields during execution.
 */
struct field_reference {
    std::vector<path_token> source_path;
};

/**
 * @brief Argument payload that can be either a literal or a field reference.
 */
using argument_value = std::variant<literal, field_reference>;

/** @brief Named argument for a declarative upgrader step. */
struct step_argument {
    std::string name;
    argument_value value;
};

/**
 * @brief One declarative upgrade step.
 *
 * @code
 * muesli::upgrade::upgrader_step step{
 *     "set_field",
 *     {std::string{"schema_version"}},
 *     {{"value", std::int64_t{3}}}
 * };
 * @endcode
 */
struct upgrader_step {
    std::string op_id;
    std::vector<path_token> target_path;
    std::vector<step_argument> arguments;
};

/**
 * @brief A versioned declarative migration document.
 *
 * @tparam Version User-defined version value type
 */
template<typename Version>
struct upgrader_document {
    Version from_version;
    Version to_version;
    std::vector<upgrader_step> steps;

    std::string name;
    std::string description;
};

/**
 * @brief Find a named argument in an upgrader step.
 * @param step Step to inspect
 * @param name Argument name to look up
 * @return Pointer to the argument when found; nullptr otherwise
 */
inline const step_argument* find_argument(const upgrader_step& step, std::string_view name) noexcept {
    for (const auto& arg : step.arguments) {
        if (arg.name == name) {
            return &arg;
        }
    }
    return nullptr;
}

/**
 * @brief Extract a typed argument value from a step.
 * @tparam T Requested literal alternative type
 * @param step Step to inspect
 * @param name Argument name
 * @return Optional value containing T when the argument exists, is a literal, and matches type
 */
template<typename T>
std::optional<T> get_argument_as(const upgrader_step& step, std::string_view name) {
    const auto* arg = find_argument(step, name);
    if (arg == nullptr) {
        return std::nullopt;
    }

    const auto* lit = std::get_if<literal>(&arg->value);
    if (lit == nullptr) {
        return std::nullopt;
    }

    if (const auto* ptr = std::get_if<T>(lit)) {
        return *ptr;
    }

    return std::nullopt;
}

} // namespace muesli::upgrade
