#pragma once

#include <muesli/upgrade/types>
#include <muesli/codecs>

namespace muesli::upgrade {

/**
 * @brief Codec for a single path_token (variant of string or size_t).
 *
 * Represented as variant_codec(string_codec, size_codec), giving a natural
 * binary wire format: uint8 discriminant followed by the alternative payload.
 *
 * @see path_token
 */
inline constexpr auto path_token_codec = muesli::variant_codec(muesli::string_codec, muesli::size_codec);

/**
 * @brief Codec for a vector of path_token.
 *
 * Encoded as a size-prefixed sequence of path_token values.
 * Wire format: size_t count, then count * (uint8 index + alternative).
 *
 * @see path_token
 */
inline constexpr auto path_token_vector_codec = muesli::vector_of(
    muesli::variant_codec(muesli::string_codec, muesli::size_codec)
);

/**
 * @brief Codec for the literal variant.
 *
 * Covers all primitive argument types: monostate, bool, int64, uint64, double, string.
 *
 * @see literal
 */
inline constexpr auto literal_codec = muesli::variant_codec(
    muesli::monostate_codec,
    muesli::bool_codec,
    muesli::int64_codec,
    muesli::uint64_codec,
    muesli::double_codec,
    muesli::string_codec
);

/**
 * @brief Codec for field_reference.
 *
 * A field_reference wraps a vector<path_token> as its source_path member.
 *
 * @see field_reference
 */
inline constexpr auto field_reference_codec = muesli::tuple_codec(
    path_token_vector_codec.member<&field_reference::source_path>()
).apply<field_reference>();

/**
 * @brief Codec for argument_value (variant of literal or field_reference).
 *
 * @see argument_value
 */
inline constexpr auto argument_value_codec = muesli::variant_codec(
    literal_codec,
    field_reference_codec
);

/**
 * @brief Codec for step_argument.
 *
 * Encodes the argument name (string) followed by its value (argument_value).
 *
 * @see step_argument
 */
inline constexpr auto step_argument_codec = muesli::tuple_codec(
    muesli::string_codec.member<&step_argument::name>(),
    argument_value_codec.member<&step_argument::value>()
).apply<step_argument>();

/**
 * @brief Codec for upgrader_step.
 *
 * Encodes op_id, target_path, and arguments in sequence.
 *
 * @see upgrader_step
 */
inline constexpr auto upgrader_step_codec = muesli::tuple_codec(
    muesli::string_codec.member<&upgrader_step::op_id>(),
    path_token_vector_codec.member<&upgrader_step::target_path>(),
    muesli::vector_of(step_argument_codec).member<&upgrader_step::arguments>()
).apply<upgrader_step>();

/**
 * @brief Build a codec for upgrader_document<Version> given a version codec.
 *
 * @tparam VersionCodec Codec type for the user-defined version type
 * @param version_codec The codec to use for encoding/decoding version values
 * @return A codec for upgrader_document<typename VersionCodec::value_type>
 *
 * @code
 * constexpr auto doc_codec = up::make_upgrader_document_codec(mu::int_codec);
 * @endcode
 *
 * @see upgrader_document
 */
template<muesli::Codec VersionCodec>
constexpr auto make_upgrader_document_codec(const VersionCodec& version_codec) {
    using Version = typename VersionCodec::value_type;

    return muesli::tuple_codec(
        version_codec.template member<&upgrader_document<Version>::from_version>(),
        version_codec.template member<&upgrader_document<Version>::to_version>(),
        muesli::vector_of(upgrader_step_codec).template member<&upgrader_document<Version>::steps>(),
        muesli::string_codec.template member<&upgrader_document<Version>::name>(),
        muesli::string_codec.template member<&upgrader_document<Version>::description>()
    ).template apply<upgrader_document<Version>>();
}

} // namespace muesli::upgrade
