#pragma once

#include <muesli/upgrade/concepts>
#include <muesli/upgrade/types>

#include <algorithm>
#include <cstddef>
#include <optional>
#include <utility>
#include <vector>

namespace muesli::upgrade {

namespace detail {

    template<typename Version>
    struct visit_node {
        Version version;
        std::optional<std::size_t> parent_node_index;
        std::optional<std::size_t> via_document_index;
    };

    template<typename Version, typename Comparator>
    requires version_comparator<Comparator, Version>
    std::optional<std::size_t> find_node_index(const std::vector<visit_node<Version>>& nodes,
                                               const Version& version,
                                               const Comparator& cmp) {
        for (std::size_t i = 0; i < nodes.size(); ++i) {
            if (version_equal(nodes[i].version, version, cmp)) {
                return i;
            }
        }
        return std::nullopt;
    }

} // namespace detail

/**
 * @brief Find a shortest migration chain by explicit version edges.
 *
 * Returns indices into @p documents representing a path from @p from_version
 * to @p to_version.
 *
 * @tparam Version User-defined version type
 * @tparam Comparator User-provided comparator type
 * @param documents Candidate migration documents
 * @param from_version Source version
 * @param to_version Target version
 * @param cmp Version comparator
 * @return Sequence of document indices, or std::nullopt when no path exists
 */
template<typename Version, typename Comparator>
requires version_comparator<Comparator, Version>
std::optional<std::vector<std::size_t>> find_upgrade_path(const std::vector<upgrader_document<Version>>& documents,
                                                          const Version& from_version,
                                                          const Version& to_version,
                                                          const Comparator& cmp) {
    if (version_equal(from_version, to_version, cmp)) {
        return std::vector<std::size_t>{};
    }

    std::vector<detail::visit_node<Version>> visited;
    visited.push_back(detail::visit_node<Version>{from_version, std::nullopt, std::nullopt});

    std::size_t queueIndex = 0;
    while (queueIndex < visited.size()) {
        const auto currentNodeIndex = queueIndex;
        const auto& currentVersion = visited[currentNodeIndex].version;
        ++queueIndex;

        for (std::size_t docIndex = 0; docIndex < documents.size(); ++docIndex) {
            const auto& doc = documents[docIndex];
            if (!version_equal(doc.from_version, currentVersion, cmp)) {
                continue;
            }

            if (detail::find_node_index<Version, Comparator>(visited, doc.to_version, cmp).has_value()) {
                continue;
            }

            visited.push_back(detail::visit_node<Version>{doc.to_version, currentNodeIndex, docIndex});
            const auto newIndex = visited.size() - 1;

            if (version_equal(visited[newIndex].version, to_version, cmp)) {
                std::vector<std::size_t> result;
                auto cursor = std::optional<std::size_t>{newIndex};
                while (cursor.has_value()) {
                    const auto& node = visited[*cursor];
                    if (node.via_document_index.has_value()) {
                        result.push_back(*node.via_document_index);
                    }
                    cursor = node.parent_node_index;
                }

                std::reverse(result.begin(), result.end());
                return result;
            }
        }
    }

    return std::nullopt;
}

} // namespace muesli::upgrade
