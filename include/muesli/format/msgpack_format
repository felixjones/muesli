    template<typename Stream>
    bool write_byte(Stream& output, std::uint8_t value) {
        const auto c = static_cast<char>(value);
        if constexpr (requires { output.write(&c, std::streamsize{1}); }) {
            output.write(&c, std::streamsize{1});
            if constexpr (requires { output.good(); }) return output.good();
            else return true;
        } else if constexpr (requires { output.put(c); }) {
            output.put(c);
            if constexpr (requires { output.good(); }) return output.good();
            else return true;
        } else if constexpr (requires { output << c; }) {
            output << c;
            if constexpr (requires { output.good(); }) return output.good();
            else return true;
        } else {
            static_assert(sizeof(Stream) == 0, "msgpack_format: unsupported output stream");
        }
    }

    template<typename Stream>
    std::optional<std::uint8_t> read_byte(Stream& input) {
        char c{};
        if constexpr (requires { input.read(&c, std::streamsize{1}); }) {
            input.read(&c, std::streamsize{1});
            if constexpr (requires { input.gcount(); }) {
                if (input.gcount() != std::streamsize{1}) return std::nullopt;
            } else if constexpr (requires { input.good(); }) {
                if (!input.good()) return std::nullopt;
            }
            return static_cast<std::uint8_t>(static_cast<unsigned char>(c));
        } else if constexpr (requires { input.get(c); }) {
            input.get(c);
            if constexpr (requires { input.good(); }) {
                if (!input.good()) return std::nullopt;
            }
            return static_cast<std::uint8_t>(static_cast<unsigned char>(c));
        } else {
            static_assert(sizeof(Stream) == 0, "msgpack_format: unsupported input stream");
        }
    }

    template<typename Stream>
    bool write_raw(Stream& output, const char* data, std::size_t size) {
        if (size == 0) return true;
        if constexpr (requires { output.write(data, static_cast<std::streamsize>(size)); }) {
            output.write(data, static_cast<std::streamsize>(size));
            if constexpr (requires { output.good(); }) return output.good();
            else return true;
        } else {
            for (std::size_t i = 0; i < size; ++i) {
                if (!write_byte(output, static_cast<std::uint8_t>(data[i]))) return false;
            }
            return true;
        }
    }

    template<typename Stream>
    std::optional<std::string> read_raw(Stream& input, std::size_t size) {
        std::string result(size, '\0');
        if (size == 0) return result;
        if constexpr (requires { input.read(result.data(), static_cast<std::streamsize>(size)); }) {
            input.read(result.data(), static_cast<std::streamsize>(size));
            if constexpr (requires { input.gcount(); }) {
                if (input.gcount() != static_cast<std::streamsize>(size)) return std::nullopt;
            } else if constexpr (requires { input.good(); }) {
                if (!input.good()) return std::nullopt;
            }
            return result;
        } else {
            for (std::size_t i = 0; i < size; ++i) {
                auto byte = read_byte(input);
                if (!byte) return std::nullopt;
                result[i] = static_cast<char>(*byte);
            }
            return result;
        }
    }

    template<typename UInt, typename Stream>
    bool write_be(Stream& output, UInt value) {
        static_assert(std::unsigned_integral<UInt>);
        for (std::size_t i = 0; i < sizeof(UInt); ++i) {
            const auto shift = static_cast<unsigned>((sizeof(UInt) - 1 - i) * 8);
            if (!write_byte(output, static_cast<std::uint8_t>((value >> shift) & UInt{0xFF}))) return false;
        }
        return true;
    }

    template<typename UInt, typename Stream>
    std::optional<UInt> read_be(Stream& input) {
        static_assert(std::unsigned_integral<UInt>);
        UInt result{};
        for (std::size_t i = 0; i < sizeof(UInt); ++i) {
            auto byte = read_byte(input);
            if (!byte) return std::nullopt;
            result = static_cast<UInt>((result << 8) | static_cast<UInt>(*byte));
        }
        return result;
    }

    template<typename Stream>
    bool write_string_header(Stream& output, std::size_t size) {
        if (size <= 31) {
            return write_byte(output, static_cast<std::uint8_t>(0xA0 | size));
        }
        if (size <= std::numeric_limits<std::uint8_t>::max()) {
            return write_byte(output, str8) && write_byte(output, static_cast<std::uint8_t>(size));
        }
        if (size <= std::numeric_limits<std::uint16_t>::max()) {
            return write_byte(output, str16) && write_be(output, static_cast<std::uint16_t>(size));
        }
        return write_byte(output, str32) && write_be(output, static_cast<std::uint32_t>(size));
    }

    template<typename Stream>
    bool write_array_header(Stream& output, std::size_t size) {
        if (size <= 15) {
            return write_byte(output, static_cast<std::uint8_t>(0x90 | size));
        }
        if (size <= std::numeric_limits<std::uint16_t>::max()) {
            return write_byte(output, array16) && write_be(output, static_cast<std::uint16_t>(size));
        }
        return write_byte(output, array32) && write_be(output, static_cast<std::uint32_t>(size));
    }

    template<typename Stream>
    bool write_map_header(Stream& output, std::size_t size) {
        if (size <= 15) {
            return write_byte(output, static_cast<std::uint8_t>(0x80 | size));
        }
        if (size <= std::numeric_limits<std::uint16_t>::max()) {
            return write_byte(output, map16) && write_be(output, static_cast<std::uint16_t>(size));
        }
        return write_byte(output, map32) && write_be(output, static_cast<std::uint32_t>(size));
    }

    template<typename Stream>
    bool write_bin_header(Stream& output, std::size_t size) {
        if (size <= std::numeric_limits<std::uint8_t>::max()) {
            return write_byte(output, bin8) && write_byte(output, static_cast<std::uint8_t>(size));
        }
        if (size <= std::numeric_limits<std::uint16_t>::max()) {
            return write_byte(output, bin16) && write_be(output, static_cast<std::uint16_t>(size));
        }
        return write_byte(output, bin32) && write_be(output, static_cast<std::uint32_t>(size));
    }

    template<typename Stream>
    bool write_ext_header(Stream& output, std::size_t size, std::int8_t type_id) {
        if (size == 1) return write_byte(output, fixext1) && write_byte(output, static_cast<std::uint8_t>(type_id));
        if (size == 2) return write_byte(output, fixext2) && write_byte(output, static_cast<std::uint8_t>(type_id));
        if (size == 4) return write_byte(output, fixext4) && write_byte(output, static_cast<std::uint8_t>(type_id));
        if (size == 8) return write_byte(output, fixext8) && write_byte(output, static_cast<std::uint8_t>(type_id));
        if (size == 16) return write_byte(output, fixext16) && write_byte(output, static_cast<std::uint8_t>(type_id));
        if (size <= std::numeric_limits<std::uint8_t>::max()) {
            return write_byte(output, ext8) && write_byte(output, static_cast<std::uint8_t>(size)) &&
                   write_byte(output, static_cast<std::uint8_t>(type_id));
        }
        if (size <= std::numeric_limits<std::uint16_t>::max()) {
            return write_byte(output, ext16) && write_be(output, static_cast<std::uint16_t>(size)) &&
                   write_byte(output, static_cast<std::uint8_t>(type_id));
        }
        return write_byte(output, ext32) && write_be(output, static_cast<std::uint32_t>(size)) &&
               write_byte(output, static_cast<std::uint8_t>(type_id));
    }

    template<typename Stream>
    std::optional<std::pair<std::size_t, std::int8_t>> read_ext_header(Stream& input, std::uint8_t marker) {
        if (marker == fixext1 || marker == fixext2 || marker == fixext4 || marker == fixext8 || marker == fixext16) {
            std::size_t size = 0;
            if (marker == fixext1) size = 1;
            if (marker == fixext2) size = 2;
            if (marker == fixext4) size = 4;
            if (marker == fixext8) size = 8;
            if (marker == fixext16) size = 16;
            auto type_byte = read_byte(input);
            if (!type_byte) return std::nullopt;
            return std::pair<std::size_t, std::int8_t>{size, static_cast<std::int8_t>(*type_byte)};
        }
        if (marker == ext8) {
            auto size = read_byte(input);
            auto type_byte = read_byte(input);
            if (!size || !type_byte) return std::nullopt;
            return std::pair<std::size_t, std::int8_t>{*size, static_cast<std::int8_t>(*type_byte)};
        }
        if (marker == ext16) {
            auto size = read_be<std::uint16_t>(input);
            auto type_byte = read_byte(input);
            if (!size || !type_byte) return std::nullopt;
            return std::pair<std::size_t, std::int8_t>{*size, static_cast<std::int8_t>(*type_byte)};
        }
        if (marker == ext32) {
            auto size = read_be<std::uint32_t>(input);
            auto type_byte = read_byte(input);
            if (!size || !type_byte) return std::nullopt;
            return std::pair<std::size_t, std::int8_t>{*size, static_cast<std::int8_t>(*type_byte)};
        }
        return std::nullopt;
    }

    template<typename Stream>
    bool write_string(Stream& output, std::string_view value) {
        return write_string_header(output, value.size()) && write_raw(output, value.data(), value.size());
    }

    template<typename Stream>
    std::optional<std::size_t> read_string_size(Stream& input, std::uint8_t marker) {
        if ((marker & 0xE0) == 0xA0) return static_cast<std::size_t>(marker & 0x1F);
        if (marker == str8) {
            auto size = read_byte(input);
            if (!size) return std::nullopt;
            return static_cast<std::size_t>(*size);
        }
        if (marker == str16) {
            auto size = read_be<std::uint16_t>(input);
            if (!size) return std::nullopt;
            return static_cast<std::size_t>(*size);
        }
        if (marker == str32) {
            auto size = read_be<std::uint32_t>(input);
            if (!size) return std::nullopt;
            return static_cast<std::size_t>(*size);
        }
        return std::nullopt;
    }

    template<typename Stream>
    std::optional<std::string> read_string(Stream& input, std::uint8_t marker) {
        auto size = read_string_size(input, marker);
        if (!size) return std::nullopt;
        return read_raw(input, *size);
    }

    template<typename Stream>
    std::optional<std::size_t> read_array_size(Stream& input, std::uint8_t marker) {
        if ((marker & 0xF0) == 0x90) return static_cast<std::size_t>(marker & 0x0F);
        if (marker == array16) {
            auto size = read_be<std::uint16_t>(input);
            if (!size) return std::nullopt;
            return static_cast<std::size_t>(*size);
        }
        if (marker == array32) {
