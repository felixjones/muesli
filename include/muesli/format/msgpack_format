    template<typename Codec>
    constexpr auto get_element_codec(const Codec& c) {
        if constexpr (requires { c.element_codec; }) {
            return c.element_codec;
        } else if constexpr (requires { c.arg_codec.element_codec; }) {
            return c.arg_codec.element_codec;
        } else if constexpr (requires { c.get_element_codec(); }) {
            return c.get_element_codec();
        }
    }

    template<typename Codec>
    constexpr auto get_value_codec(const Codec& c) {
        if constexpr (requires { c.value_codec; }) {
            return c.value_codec;
        } else if constexpr (requires { c.arg_codec.value_codec; }) {
            return c.arg_codec.value_codec;
        } else if constexpr (requires { c.get_value_codec(); }) {
            return c.get_value_codec();
        }
    }

    template<typename Codec>
    concept HasElementCodec = requires(const Codec& c) { c.element_codec; } ||
                              requires(const Codec& c) { c.arg_codec.element_codec; } ||
                              requires(const Codec& c) { c.get_element_codec(); };

    template<typename Codec>
    concept HasValueCodec = requires(const Codec& c) { c.value_codec; } ||
                            requires(const Codec& c) { c.arg_codec.value_codec; } ||
                            requires(const Codec& c) { c.get_value_codec(); };

    template<typename C, typename = void>
    struct element_value_type_or_void { using type = void; };
    template<typename C>
    struct element_value_type_or_void<C, std::void_t<decltype(std::declval<C&>().element_codec)>> {
        using type = typename std::decay_t<decltype(std::declval<C&>().element_codec)>::value_type;
    };
    template<typename C>
    using element_value_type_or_void_t = typename element_value_type_or_void<C>::type;

