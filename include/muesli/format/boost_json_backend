#pragma once

#include <muesli/format/json_backend>

#include <boost/json.hpp>

#include <cstdint>
#include <string>
#include <vector>

namespace muesli {

/**
 * @brief JsonBackend implementation for Boost.JSON
 *
 * Adapts Boost.JSON (https://www.boost.org/doc/libs/release/libs/json/)
 * to the muesli JsonBackend concept. Include this header and use
 * `make_json_format<boost_json_backend>(codec)` to serialize/deserialize
 * via boost::json::value DOM nodes.
 *
 * @code
 * #include <muesli/format/json_format>
 * #include <muesli/format/boost_json_backend>
 * #include <muesli/codecs>
 *
 * auto fmt = muesli::make_json_format<muesli::boost_json_backend>(muesli::int32_codec);
 * boost::json::value j = fmt.serialize(42);
 * std::string s = boost::json::serialize(j); // "42"
 * auto val = fmt.deserialize(boost::json::parse("42"));
 * @endcode
 */
struct boost_json_backend {
    using value_type = boost::json::value;

    // Factory
    static value_type make_null() { return nullptr; }
    static value_type make_bool(bool b) { return b; }
    static value_type make_int(std::int64_t i) { return i; }
    static value_type make_uint(std::uint64_t u) { return u; }
    static value_type make_float(double d) { return d; }
    static value_type make_string(std::string s) { return boost::json::string(s); }
    static value_type make_array() { return boost::json::array{}; }
    static value_type make_object() { return boost::json::object{}; }

    // Array operations
    static void array_push_back(value_type& arr, const value_type& elem) {
        arr.as_array().push_back(elem);
    }
    static std::size_t array_size(const value_type& arr) {
        return arr.as_array().size();
    }
    static const value_type& array_at(const value_type& arr, std::size_t idx) {
        return arr.as_array().at(idx);
    }

    // Object operations
    static void object_set(value_type& obj, const std::string& key, const value_type& val) {
        obj.as_object()[key] = val;
    }
    static const value_type& object_get(const value_type& obj, const std::string& key) {
        return obj.as_object().at(key);
    }
    static bool object_has_key(const value_type& obj, const std::string& key) {
        return obj.as_object().contains(key);
    }
    static std::vector<std::string> object_keys(const value_type& obj) {
        std::vector<std::string> keys;
        for (const auto& kv : obj.as_object()) {
            keys.emplace_back(kv.key());
        }
        return keys;
    }

    // Type queries
    static bool is_null(const value_type& v) { return v.is_null(); }
    static bool is_bool(const value_type& v) { return v.is_bool(); }
    static bool is_integer(const value_type& v) { return v.is_int64() || v.is_uint64(); }
    static bool is_floating(const value_type& v) { return v.is_double(); }
    static bool is_string(const value_type& v) { return v.is_string(); }
    static bool is_array(const value_type& v) { return v.is_array(); }
    static bool is_object(const value_type& v) { return v.is_object(); }

    // Accessors
    static bool as_bool(const value_type& v) { return v.as_bool(); }
    static std::int64_t as_int64(const value_type& v) {
        if (v.is_uint64()) return static_cast<std::int64_t>(v.as_uint64());
        return v.as_int64();
    }
    static std::uint64_t as_uint64(const value_type& v) {
        if (v.is_int64()) return static_cast<std::uint64_t>(v.as_int64());
        return v.as_uint64();
    }
    static double as_double(const value_type& v) {
        if (v.is_int64()) return static_cast<double>(v.as_int64());
        if (v.is_uint64()) return static_cast<double>(v.as_uint64());
        return v.as_double();
    }
    static std::string as_string(const value_type& v) {
        const auto& sv = v.as_string();
        return std::string(sv.data(), sv.size());
    }
};

} // namespace muesli
